# Use the local Docker Compose database by default.
DATABASE_URL=postgresql+asyncpg://mnemosyne:mnemosyne@localhost:5432/mnemosyne

# Default uses a small local hashed-vector provider. For local semantic embeddings,
# set EMBEDDING_PROVIDER=ollama and use an Ollama model with 384-dimensional output.
EMBEDDING_PROVIDER=hash
EMBEDDING_MODEL=all-minilm

# Optional. When set, API calls must send X-API-Key; the web UI prompts for it.
# API_KEY=replace-with-a-long-random-value

# Optional. Used only when you preview a notepad draft; the selected model is free
# and requests are capped at $0 per token. Keep this key in your local .env only.
# OPENROUTER_API_KEY=replace-with-your-openrouter-key

